{
  "name": "BOTTOM LEFT BOLD",
  "font": "Archivo Black",
  "size": 82,
  "uppercase": true,
  "letter_spacing": 0.0,
  "colors": {
    "text": "#FFFFFF",
    "active": "#FFD400",
    "outline": "#000000",
    "shadow": "#00000000",
    "box": "#00000000"
  },
  "active_word": {
    "effect": "pop",
    "scale": 1.1,
    "box": false
  },
  "entrance": {
    "effect": "slide",
    "duration_ms": 120
  },
  "exit": {
    "effect": "none",
    "duration_ms": 0
  },
  "layout": {
    "position": "bottom",
    "max_words": 3,
    "margin_l": 90,
    "margin_r": 80,
    "margin_v": 140,
    "align": "left"
  }
}

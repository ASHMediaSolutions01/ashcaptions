{
  "name": "HEADLINE",
  "font": "Titan One",
  "size": 100,
  "uppercase": true,
  "letter_spacing": 0.0,
  "colors": {
    "text": "#FFFFFF",
    "active": "#FFD400",
    "outline": "#000000",
    "shadow": "#00000000",
    "box": "#00000000"
  },
  "active_word": {
    "effect": "pop",
    "scale": 1.12,
    "box": false
  },
  "entrance": {

    "duration_ms": 120
  },
  "exit": {
    "effect": "none",
    "duration_ms": 0
  },
  "layout": {
    "position": "top",
    "max_words": 3,
    "margin_l": 80,
    "margin_r": 80,
    "margin_v": 140,
    "align": "center"
  }
}

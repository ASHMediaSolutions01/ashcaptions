{
  "name": "MARKER",
  "font": "Permanent Marker",
  "size": 90,
  "uppercase": false,
  "letter_spacing": 0.0,
  "colors": {
    "text": "#FFF8DC",
    "active": "#FF5722",
    "outline": "#000000",
    "shadow": "#00000000",
    "box": "#00000000"
  },
  "active_word": {
    "effect": "pop",
    "scale": 1.15,
    "box": false
  },
  "entrance": {
    "effect": "rise",
    "duration_ms": 120
  },
  "exit": {
    "effect": "none",
    "duration_ms": 0
  },
  "layout": {
    "position": "center",
    "max_words": 3,
    "margin_l": 80,
    "margin_r": 80,
    "margin_v": 0,
    "align": "center"
  }
}

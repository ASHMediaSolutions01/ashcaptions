{
  "name": "TOP BAR",
  "font": "Bebas Neue",
  "size": 84,
  "uppercase": true,
  "letter_spacing": 1.5,
  "colors": {
    "text": "#FFFFFF",
    "active": "#FFFFFF",
    "outline": "#000000",
    "shadow": "#00000000",
    "box": "#C8102EEE"
  },
  "active_word": {
    "effect": "box",
    "scale": 1.1,
    "box": true
  },
  "entrance": {
    "effect": "slide",
    "duration_ms": 140
  },
  "exit": {
    "effect": "none",
    "duration_ms": 0
  },
  "layout": {
    "position": "top",
    "max_words": 5,
    "margin_l": 80,
    "margin_r": 80,
    "margin_v": 120,
    "align": "center"
  }
}

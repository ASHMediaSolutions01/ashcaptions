# ASH Captions — never commit client data or heavy artifacts
in/
out/
*.mp4
*.mov
*.mkv
*.mxf
glossaries/
models/
*.log
.venv/
dist/
build/

# Ruflo/claude-flow runtime state — machine-local, not source
.claude-flow/
.swarm/
# Agent worktrees checked out under the repo itself
.claude/worktrees/

# Python bytecode and build output
__pycache__/
*.py[cod]
*.egg-info/
bin/

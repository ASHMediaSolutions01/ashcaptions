# their licence texts under assets/fonts/licenses/ are committed.
assets/fonts/*.ttf

# Playwright MCP session artefacts
.playwright-mcp/

# Claude Code / ruflo tooling: kept on the dev machine, not part of the product
.claude/
.agents/
.mcp.json
